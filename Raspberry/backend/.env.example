# Copy values from the existing server environment; never commit them.
TIGER_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SMARTWASTE_API_KEY=replace-with-existing-device-key
SMARTWASTE_LEGACY_URL=http://127.0.0.1:8000
SMARTWASTE_SESSION_HOURS=12
# Server-only free-tier routing credentials; use python -m smartwaste.configure_routes.
# OPENROUTESERVICE_API_KEY=your-free-standard-key
# GEMINI_API_KEY=your-ai-studio-key
# GEMINI_MODEL=exact-model-id-with-free-quota-in-your-project
# SMARTWASTE_SOLANA_KEYPAIR=/home/djoldskull/.config/smartwaste/solana-devnet.json
# Optional override. Default: backend/config/ultrasonic_thresholds.h
# SMARTWASTE_ULTRASONIC_CONFIG=/home/djoldskull/smartwaste/backend/config/ultrasonic_thresholds.h
