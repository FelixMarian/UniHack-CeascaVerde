  "components": {
    "schemas": {
      "Assignments": {
        "properties": {
          "bin_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Bin Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "bin_ids"
        ],
        "title": "Assignments"
      },
      "BinInput": {
        "properties": {
          "bin_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "title": "Bin Id"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 90.0,
                "minimum": -90.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 180.0,
                "minimum": -180.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          },
          "company_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "bin_id",
          "name"
        ],
        "title": "BinInput"
      },
      "CollectionInput": {
        "properties": {
          "bin_id": {
            "type": "string",
            "title": "Bin Id"
          },
          "confirmed_by": {
            "type": "string",
            "title": "Confirmed By"
          }
        },
        "type": "object",
        "required": [
          "bin_id",
          "confirmed_by"
        ],
        "title": "CollectionInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IncidentCreate": {
        "properties": {
          "bin_id": {
            "type": "string",
            "title": "Bin Id"
          },
          "category": {
            "type": "string",
            "enum": [
              "damaged",
              "overflow",
              "missed_collection",
              "other"
            ],
            "title": "Category"
          },
          "comment": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Comment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "bin_id",
          "category",
          "comment"
        ],
        "title": "IncidentCreate"
      },
      "IncidentStatus": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "open",
              "in_progress",
              "resolved"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "IncidentStatus"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "PasswordChange": {
        "properties": {
          "current_password": {
            "type": "string",
            "title": "Current Password"
          },
          "new_password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "New Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "PasswordChange"
      },
      "Reading": {
        "properties": {
          "bin_id": {
            "type": "string",
            "title": "Bin Id"
          },
          "fill_level": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Fill Level"
          },
          "battery": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Battery"
          }
        },
        "type": "object",
        "required": [
          "bin_id",
          "fill_level"
        ],
        "title": "Reading"
      },
      "UserCreate": {
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]{3,80}$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "display_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Display Name"
          },
          "role": {
            "type": "string",
            "enum": [
              "Resident",
              "Company"
            ],
            "title": "Role"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password",
          "display_name",
          "role"
        ],
        "title": "UserCreate"
      },
      "UserEdit": {
        "properties": {
          "display_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Display Name"
